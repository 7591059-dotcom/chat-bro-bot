{
  "name": "chat-bro-bot",
  "version": "0.1.0",
  "description": "Configurable Telegram group chat bot with OpenAI-compatible AI, layered memory, image generation, and reminders.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
