# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me

# AI provider. For OpenAI leave OPENAI_BASE_URL empty.
OPENAI_API_KEY=sk-replace_me
OPENAI_BASE_URL=
AI_API_STYLE=responses
AI_MODEL=gpt-5.4-mini
AI_REASONING_EFFORT=low
AI_VERBOSITY=low

# Optional image generation. Uses the Responses API hosted image_generation tool.
IMAGE_ENABLED=true
IMAGE_MODEL=gpt-5.4-mini
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium

# Bot behavior
BOT_NAME=Бро
BOT_LANGUAGE=ru
BOT_PERSONA=Ты дружелюбный помощник в общем чате. Отвечай по-русски, живо, коротко и по делу.
TRIGGER_WORDS=бро,братан,бот
MAX_REPLY_CHARS=3500

# Memory
MEMORY_ENABLED=true
MEMORY_LEARN_FROM_UNTRIGGERED=false
MEMORY_MAX_CONTEXT_ITEMS=12
MEMORY_SHORT_TURNS=24
DATA_DIR=./data

# Reminders
REMINDERS_ENABLED=true
REMINDER_CHECK_SECONDS=30

# Admins. Empty means Telegram chat admins can change group settings.
ADMIN_USER_IDS=
